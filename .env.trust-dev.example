# FrostGate Customer-Zero — DEVELOPMENT TRUST ENVIRONMENT
#
# DEVELOPMENT ONLY. Does NOT satisfy CUSTOMER-ZERO-TRUST-001.
# Production requires HCP Vault Dedicated + AppRole + HTTPS.
#
# Usage:
#   make trust-dev-up            # starts local vault, configures keys/roles
#   source .env.trust-dev        # load env vars for manual testing
#   make trust-dev-test          # run integration tests
#   make trust-dev-down          # stop local vault
#
# The dev root token below is not a real secret — it controls a
# disposable in-memory vault server with no persistent state.
# DO NOT use these values for any non-development purpose.

FG_CUSTOMER_ZERO_VAULT_AUTH_MODE=static_token
FG_CUSTOMER_ZERO_ENVIRONMENT=development
FG_CUSTOMER_ZERO_VAULT_ADDR=http://127.0.0.1:8200
FG_CUSTOMER_ZERO_VAULT_TOKEN=dev-only-trust-token
FG_CUSTOMER_ZERO_IDENTITY_KEY_ID=customer-zero-identity
FG_CUSTOMER_ZERO_ACCEPTANCE_KEY_ID=customer-zero-acceptance
FG_CUSTOMER_ZERO_APPROVAL_KEY_ID=customer-zero-approval
FG_CUSTOMER_ZERO_VAULT_ISSUER=vault-transit-dev
