# Portal BFF environment variables - copy to .env.local and fill in values
# Never expose these as NEXT_PUBLIC_* unless explicitly marked public.

CORE_API_URL=http://localhost:8000
CORE_API_KEY=
CORE_TENANT_ID=
PORTAL_SESSION_SECRET=

# Production named-user cutover (PR B):
# - FG_ENV=prod (or missing/unknown) disables the legacy demo/shared-password
#   login server-side. Only the OIDC named-user flow is available.
# - FG_ENV=dev|development|local|test leaves the demo path enabled for local
#   development. NEXT_PUBLIC_FG_ENV mirrors this to the client so the login
#   page can render the correct panel; the server-side gate is authoritative.
FG_ENV=dev
NEXT_PUBLIC_FG_ENV=dev

# Auth0 (portal named-user identity provider):
PORTAL_AUTH0_DOMAIN=
PORTAL_AUTH0_CLIENT_ID=
PORTAL_AUTH0_CLIENT_SECRET=
PORTAL_AUTH0_CALLBACK_URL=http://localhost:3001/api/auth/oidc/callback
PORTAL_AUTH0_AUDIENCE=

# Optional demo tenant routing (dev/test only — ignored in prod). Portal
# sessions remain tenant-bound; this only lets the login page select one of
# the server-approved demo tenants for the shared-password path.
FG_PORTAL_DEMO_TENANTS=
# JSON object: {"demo-bank":"fgk...","demo-healthcare":"fgk..."}
FG_PORTAL_DEMO_TENANT_KEYS=
# Shared alternative read by console and portal when app-specific vars are unset.
FG_DEMO_TENANT_API_KEYS=

# Public selector list rendered on the portal login page. Keep it in sync with
# FG_PORTAL_DEMO_TENANTS; it contains tenant IDs only, not secrets.
NEXT_PUBLIC_PORTAL_DEMO_TENANTS=

PORTAL_RL_WINDOW_MS=60000
PORTAL_RL_MAX_REQUESTS=60
